POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-random-local-password@localhost:5432/ecoscan
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPOSE_TOKEN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EcoScan
SMTP_USE_TLS=true
SMTP_USE_SSL=false
IMAGE_RETENTION_DAYS=90
ECOSCAN_DEVICE=cpu
ECOSCAN_MODEL_HOST_PATH=./ecoscan/best.pt

# AWS S3 (deixe em branco para usar armazenamento local de fallback)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=ecoscan-plant-images
AWS_S3_ENDPOINT_URL=

# ElastiCache Redis / Valkey
REDIS_HOST=clustercfg.ecoscan-cache.t1ydcy.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_USE_TLS=true
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Amazon DynamoDB (Auditoria e Logs NoSQL)
DYNAMODB_TABLE_NAME=ecoscan_audit_logs
DYNAMODB_ENABLED=true
